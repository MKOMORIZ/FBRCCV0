@Library('GITDEMO_Shared_Lib@Git2IspwFts') _

String hostCredentialsId    = 'db058384-e215-4cc3-a88f-1f0ee3ec014c'                    /* Change to Jenkins credentials ID for Host userid/password            */
String cesCredentialsId     = 'db058384-e215-4cc3-a88f-1f0ee3ec014c'                    /* Change to Jenkins credentials ID for CES token                       */
String gitRepoUrl           = 'https://github.com/CPWRGIT/FBRCCV0.git'                  /* Change "<repo>" to user specific repository name                     */
String gitCredentialsId     = 'ad70bc1f-0ac6-4900-9ff2-203d1a9cf12c'                    /* Change to Jenkins credentials ID for GitHub personal access token    */
String ccRepo               = 'IBZKXM.DEMO.CC.REPOSIT'                                  /* Change to user specific code coverage repository                     */

git2Ispw(
    hostCredentialsId:    hostCredentialsId,
    cesCredentialsId:     cesCredentialsId, 
    gitCredentialsId:     gitCredentialsId, 
    gitRepoUrl:           gitRepoUrl,       
    ccRepo:               ccRepo
)
